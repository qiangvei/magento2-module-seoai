                            <?= $block->escapeHtml((string) $option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
                <div class="note">
                    <?= $block->escapeHtml(__('Meta values are written in the selected store scope.')) ?>
                </div>
            </div>
        </div>

        <div class="admin__field field field-attribute_set_id">
            <label class="label admin__field-label" for="attribute_set_id">
                <span><?= $block->escapeHtml(__('Attribute Set')) ?></span>
            </label>
            <div class="admin__field-control control">
                <select id="attribute_set_id" name="attribute_set_id" class="admin__control-select">
                    <?php foreach ($block->getAttributeSetOptions() as $option): ?>
                        <option value="<?= (int) $option['value'] ?>">
                            <?= $block->escapeHtml((string) $option['label']) ?>
                        </option>
                    <?php endforeach; ?>
                </select>
            </div>
        </div>

        <div class="admin__field field field-product_ids">
            <label class="label admin__field-label" for="product_ids">
